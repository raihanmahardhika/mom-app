# ============================================================
#  Konfigurasi Notula / MoM Generator
#  Salin file ini menjadi ".env" lalu sesuaikan nilainya.
# ============================================================

# ---------- LLM penyusun MoM ----------
# Backend: openai | ollama | rule
LLM_BACKEND=openai

# >>> GANTI DENGAN API KEY ANDA <<<
# Ambil di https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-ganti-dengan-api-key-anda

OPENAI_MODEL=gpt-5-nano
# Reasoning effort: minimal | low | medium | high
# "minimal" paling cepat & murah, cukup untuk ekstraksi notulen.
OPENAI_REASONING_EFFORT=minimal
OPENAI_MAX_OUTPUT_TOKENS=6000
# Transkrip lebih panjang dari context window model dipecah per bagian (karakter)
LLM_CHUNK_CHARS=30000
OPENAI_TIMEOUT=600

# Opsional — untuk Azure OpenAI / gateway kompatibel
# OPENAI_BASE_URL=

# ---------- Ollama (LLM lokal, dipakai bila LLM_BACKEND=ollama) ----------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct

# ---------- Whisper (transkripsi, berjalan lokal) ----------
WHISPER_BACKEND=faster
# tiny | base | small | medium | large-v3
WHISPER_MODEL=small
WHISPER_LANGUAGE=id
# cuda (GPU NVIDIA) | cpu | auto
WHISPER_DEVICE=cuda
# float16 untuk GPU, int8 untuk CPU
WHISPER_COMPUTE=float16
WHISPER_BEAM_SIZE=5

# ---------- Upload ----------
# Batas untuk setiap dokumen catatan (PDF, DOCX, TXT, atau MD)
MAX_NOTE_FILE_MB=25
# Jumlah maksimum dokumen catatan dalam satu MoM
MAX_NOTE_FILES=10
# Jumlah maksimum rekaman audio/video dalam satu MoM (ditranskripsi berurutan)
MAX_RECORDINGS=5
# MOM_DATA_DIR=
